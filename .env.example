# ── JWT & Security ──────────────────────────────────────────────────────────
# REQUIRED: Change this to a random 32+ character hex string for production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM

# ── OpenAI / CrewAI ─────────────────────────────────────────────────────────
# Required if using CrewAI agents that call GPT (compliance narrative generation).
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── NVIDIA NIM / CrewAI ─────────────────────────────────────────────────────
# NVIDIA API key, Base URL and model for Llama-3.3-70b-instruct
NVIDIA_API_KEY=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
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct

# ── Audit Trail Storage ──────────────────────────────────────────────────────
# Path to the immutable audit log file (15-year retention).
# NOTE: /tmp is ephemeral on Vercel — use an absolute path or external DB in prod.
AUDIT_LOG_PATH=/tmp/audit_trail.log

# ── Uvicorn Server ───────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── OTP Settings ─────────────────────────────────────────────────────────────
# OTP time-to-live in seconds (default 180 = 3 minutes)
OTP_TTL_SECONDS=180
# Maximum verification attempts before lockout
OTP_MAX_ATTEMPTS=3
# Initial resend backoff in seconds (doubles on each resend)
OTP_RESEND_BACKOFF_SECONDS=30

# ── WhatsApp Delivery (Twilio) ────────────────────────────────────────────────
# Uncomment and fill in when ready to deliver real WhatsApp OTPs via Twilio.
# Without these, OTP is printed to server logs only (safe for development).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Flask Legacy Routes ───────────────────────────────────────────────────────
# Passed through to the Flask sub-app for any legacy configuration.
# FLASK_SECRET_KEY=another-flask-secret
